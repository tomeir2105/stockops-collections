- name: Compute runtime order (prefer inventory override if set)
  ansible.builtin.set_fact:
    _router_order: >-
      {{
        (router_scripts_order | length > 0)
        | ternary(router_scripts_order, lookup('ansible.builtin.pipe', "ls -1 " ~ router_scripts_dir ~ " | sort -V").splitlines())
      }}

- name: Show planned execution order
  ansible.builtin.debug:
    var: _router_order

- name: Execute scripts in order (source /etc/stockops/vars.env)
  become: true
  ansible.builtin.shell: |
    set -euo pipefail
    [ -f /etc/stockops/vars.env ] && . /etc/stockops/vars.env || true
    exec bash "{{ router_scripts_dir }}/{{ item }}"
  args:
    executable: /bin/bash
  loop: "{{ _router_order }}"
  when: router_run_scripts | bool
