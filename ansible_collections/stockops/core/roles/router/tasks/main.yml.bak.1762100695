---
- name: Router role loaded
  ansible.builtin.debug:
    msg: "router role ready (deploy={{ router_deploy_scripts }}, run={{ router_run_scripts | length }} scripts)"

- name: Deploy router assets (scripts+config)
  ansible.builtin.include_tasks: deploy-scripts.yml
  when: router_deploy_scripts | bool

- name: Execute selected scripts
  ansible.builtin.include_tasks: run-scripts.yml
  when: (router_run_scripts | length) > 0
- include_tasks: gen-vars-env.yml
