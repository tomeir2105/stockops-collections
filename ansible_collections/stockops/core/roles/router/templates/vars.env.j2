# Generated from Ansible vars (safe for export). Edit your *.example files, not this.
{% for k, v in vars.items() -%}
{% if k not in ['ansible_facts','hostvars','groups','group_names','inventory_hostname','play_hosts','playbook_dir','role_path'] -%}
STOCKOPS_{{ k | upper }}="{{ v | string | replace('"','\"') }}"
{% endif -%}
{% endfor -%}
